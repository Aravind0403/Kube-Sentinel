FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including procps for pkill/diagnostics
RUN apt-get update && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/*

# Install dependencies (gRPC + Pydantic + CostEngine dependencies)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy core modules and V2 source code
COPY core/ ./core/
COPY v2/ ./v2/

# Make modules importable
ENV PYTHONPATH=/app:/app/core:/app/v2/proto

EXPOSE 50051

CMD ["python", "v2/grpc_server.py"]
